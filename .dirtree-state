# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime/targets = Declares the exact x86_64-linux Nix check built by Mechatron Prime.
	PLAN.md = Tracks current work items, edge cases, and completion times.
	README.md = Documents sctui features, limitations, licensing, and live Mechatron Prime CI status.
	build = Runs the pinned hermetic Nix release build.
	flake.lock = Locks nixpkgs for reproducible flake evaluation and builds.
	flake.nix = Pinned hermetic build and check outputs plus a Rustfmt-equipped development shell.
	src/api/calls/albums.rs = Classifies albums from the cached api-v2 library and fetches selected album tracks.
	src/api/calls/following.rs = Loads user-scoped api-v2 followings and fetches published or liked tracks for a selected user.
	src/api/calls/likes.rs = Fetches liked tracks through browser-compatible api-v2 /me and user-scoped track-likes endpoints.
	src/api/calls/playlists.rs = Loads playlist views from the cached api-v2 library and fetches selected playlist tracks.
	src/api/mod.rs = Owns API authentication, api-v2 origin, signed-in user state, and pagination cursors.
	src/api/models.rs = Defines SoundCloud entities and user-facing playback restriction classifications.
	src/api/utils.rs = Parses shared track models and selects supported non-DRM API-v2 HLS transcodings.
	src/auth/firefox.rs = Finds SoundCloud OAuth cookies in private snapshots of Firefox profile databases.
	src/auth/mod.rs = Selects startup credentials by saved-token, app OAuth, then Firefox fallback precedence.
	src/auth/token.rs = Models refreshable application tokens and non-refreshable Firefox session tokens; builds OAuth headers.
	src/player/controller.rs = Queues uniquely identified playback attempts and exposes one-shot worker outcomes.
	src/player/stream/engine.rs = Resolves SoundCloud transcodings, prepares HLS audio, and returns playback failures.
	src/player/worker.rs = Executes player commands and retains user-visible playback errors.
	src/tui/layout.rs = Computes shared render and mouse hit regions, table rows, tabs, and seek positions.
	src/tui/logic/input/commands.rs = Handles character commands plus focused, Enter-submitted Search input.
	src/tui/logic/input/mouse.rs = Maps mouse clicks, double-clicks, wheel movement, collection panes, track panes, and progress seeking into TUI state.
	src/tui/logic/utils.rs = Provides queue, search, and finite playback-recovery helpers.
	src/tui/render/overlays/help.rs = Renders the keyboard and mouse control reference popup.
	src/tui/render/status.rs = Purely renders the approved scrolling shortcut line or red playback errors.
	src/tui/render/tabs/search.rs = Renders Search collections and positions the native cursor over centered UTF-8 input.
	test = Runs the current-system Nix check and returns its accumulated failure count.
]
